# Public site URL — used for SEO canonical/OG tags, sitemap, robots.
# Must be the www host: apex cue-app.net 308-redirects to www at the platform
# level, and every canonical/hreflang/sitemap URL derives from this value.
NEXT_PUBLIC_SITE_URL=https://www.cue-app.net

# Optional: forward Reach Out / FAQ form submissions to a webhook
# (Zapier, Make, Google Sheets, a CRM endpoint, etc.). If unset,
# submissions are logged to the server console (visible in Vercel logs).
# LEAD_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/xxxx/yyyy

# Firebase web app (project cue-e00d5) — powers the /partner/apply form's
# Storage uploads (menu PDF + photos). The partnerApplications DOCUMENT is not
# written from the browser: it goes through /api/partner-apply on the Admin SDK,
# because the collection has no client-write rule. Values come from the
# Firebase console (Project settings → Your apps → Web) or the Flutter app's
# lib/firebase_options.dart (the `web` FirebaseOptions block). A web config is
# public by design, but keep the real values in Vercel env, not the repo.
# Without these the form still works: submissions fall back to LEAD_WEBHOOK_URL
# (file uploads are skipped in that mode).
# NEXT_PUBLIC_FIREBASE_API_KEY=
# NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=cue-e00d5.firebaseapp.com
# NEXT_PUBLIC_FIREBASE_PROJECT_ID=cue-e00d5
# NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=cue-e00d5.firebasestorage.app
# NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
# NEXT_PUBLIC_FIREBASE_APP_ID=

# Cue Insider claim flow (/claim + /api/cue-insider/*).
# Cloudflare Turnstile: site key is public (rendered in the form widget);
# secret key is server-only. If the secret is unset in production the claim
# API fails closed (503); in dev it falls back to Cloudflare's always-pass
# test secret. With CUE_BACKEND_CLAIM=django the secret half lives on the API
# host (TURNSTILE_SECRET_KEY in /opt/cue/.env) and must pair with this site
# key; the site key stays here either way.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=
# Server-only Admin SDK credential: the service-account key JSON, base64
# encoded (raw JSON also accepted). Never expose with a NEXT_PUBLIC_ prefix.
# REQUIRED for /api/partner-apply: it persists partner applications AND holds
# the IP rate-limit counter. Without it (and without FIRESTORE_EMULATOR_HOST)
# that route fails closed with 503 rather than accepting unmetered submissions
# — an endpoint we cannot rate limit is not one to leave open.
# /api/lead holds its own counter here too (collection `leadRateLimits`, 5 per
# 10 min). That route has no other Firebase dependency, so it fails closed only
# IN PRODUCTION; locally it logs and accepts, keeping the webhook-only fallback
# mode working.
# FIREBASE_SERVICE_ACCOUNT_JSON=
# REQUIRED IN PRODUCTION. Salt for every hashed identifier we persist:
# the rate-limit keys (ipHash — Cue Insider claims, partner applications, leads)
# and the dedupe index keys (emailHash/phoneHash).
# There is deliberately NO default — an unset value throws in production
# (the claim route and /api/partner-apply both return 503) rather than hashing
# PII with a guessable salt.
# Generate a fresh random value; never reuse the text in this file:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Changing it resets open rate-limit windows (claims, partner applications AND
# leads) AND orphans existing dedupe index entries (cueInsiderClaimIndex), so a
# prior claimant could claim again.
# CUE_INSIDER_IP_HASH_SALT=

# Cue Django API (server-to-server; Firebase -> Django migration, WEB-0 onward).
# The base URL INCLUDES the version prefix. Vercel Preview -> staging,
# Production -> prod. Routes flipped to django fail closed (503) while this is
# unset; the stats beacon (/api/cue-insider/event) stays 204 and drops the event.
#   prod     https://api.cue-app.net/api/v1
#   staging  https://api-staging.cue-app.net/api/v1
# CUE_API_BASE_URL=https://api.cue-app.net/api/v1
# Service key sent as X-Cue-Api-Key on every call; Django honours the
# X-Cue-Client-Ip header (rate limits, Turnstile) only alongside a valid key.
# Server-only, never NEXT_PUBLIC_. Minted on the backend, never a Firebase-era
# value; paste it into the Vercel UI text field, not a file upload (BOM).
# CUE_API_KEY=
# Same base URL, exposed to the browser: the partner form uploads files straight
# to Django (Vercel caps request bodies at 4.5 MB) and CSP connect-src needs
# the host (WEB-4).
# NEXT_PUBLIC_CUE_API_BASE_URL=https://api.cue-app.net/api/v1
# Rollout switch (src/lib/backend-flag.ts): which backend each proxied route
# talks to. Unset = firebase; so is any value other than firebase|django (with
# a warning). A per-route value overrides CUE_BACKEND for that route only; flip
# one route at a time in Vercel prod with a smoke check each.
# CUE_BACKEND=firebase
# CUE_BACKEND_WAITLIST=
# CUE_BACKEND_EVENT=
# CUE_BACKEND_LEAD=
# CUE_BACKEND_CLAIM=
# CUE_BACKEND_PARTNER=
