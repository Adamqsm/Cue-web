# Public site URL — used for SEO canonical/OG tags, sitemap, robots.
# Must be the www host: apex cue-app.net 308-redirects to www at the platform
# level, and every canonical/hreflang/sitemap URL derives from this value.
NEXT_PUBLIC_SITE_URL=https://www.cue-app.net

# Cloudflare Turnstile site key for the Cue Insider claim form (/claim). Public:
# rendered in the form widget. The secret half lives on the API host
# (TURNSTILE_SECRET_KEY in /opt/cue/.env) and must pair with this site key.
# NEXT_PUBLIC_TURNSTILE_SITE_KEY=

# Cue Django API (server-to-server). Every /api route proxies to it.
# The base URL INCLUDES the version prefix. Vercel Preview -> staging,
# Production -> prod. Every route fails closed (503) while this is unset; the
# stats beacon (/api/cue-insider/event) stays 204 and drops the event.
#   prod     https://api.cue-app.net/api/v1
#   staging  https://api-staging.cue-app.net/api/v1
# CUE_API_BASE_URL=https://api.cue-app.net/api/v1
# Service key sent as X-Cue-Api-Key on every call; Django honours the
# X-Cue-Client-Ip header (rate limits, Turnstile) only alongside a valid key.
# Server-only, never NEXT_PUBLIC_. Minted on the backend; paste it into the
# Vercel UI text field, not a file upload (BOM).
# CUE_API_KEY=
# No browser-side copy of the base URL is needed: the partner form uploads to
# the uploadUrl the API returns, and next.config.mjs lists both API origins in
# CSP connect-src.

# Cue portal (restaurant sign-in). The header "Restaurant login" link goes to
# <this>/login?lang=<en|ar>. Defaults to https://portal.cue-app.net when unset.
NEXT_PUBLIC_PORTAL_URL=https://portal.cue-app.net
